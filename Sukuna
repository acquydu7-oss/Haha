-- Helpers
local function sec(t)
    local s=Instance.new("TextLabel",Sc)
    s.Size=UDim2.new(1,-8,0,22) s.BackgroundColor3=Color3.fromRGB(50,10,15)
    s.Text="▬ "..t.." ▬" s.TextColor3=Color3.fromRGB(255,120,120)
    s.TextScaled=true s.Font=Enum.Font.GothamBold
    Instance.new("UICorner",s).CornerRadius=UDim.new(0,6)
end
local function btn(t,c,f)
    local b=Instance.new("TextButton",Sc)
    b.Size=UDim2.new(1,-8,0,32) b.BackgroundColor3=Color3.fromRGB(30,10,15)
    b.Text=t b.TextColor3=c b.TextScaled=true
    b.Font=Enum.Font.GothamBold b.AutoButtonColor=false
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,8)
