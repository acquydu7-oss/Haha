local function buildFlash()
    local c=L.Character if not c then return end
    local hand=c:FindFirstChild("RightHand")or c:FindFirstChild("Right Arm")
    if not hand then return end
    if flashPart then flashPart:Destroy()end
    if flashLight then flashLight:Destroy()end
    flashPart=Instance.new("Part")
    flashPart.Name="HV3_Flash"
    flashPart.Size=Vector3.new(.4,.4,1.2)
    flashPart.Transparency=.4
    flashPart.CanCollide=false
    flashPart.CanQuery=false
    flashPart.CanTouch=false
    flashPart.Massless=true
    flashPart.Anchored=false
    flashPart.Material=Enum.Material.Metal
    flashPart.Color=Color3.fromRGB(40,40,40)
    flashPart.Parent=c
    local weld=Instance.new("Weld")
    weld.Part0=hand
    weld.Part1=flashPart
    weld.C0=CFrame.new(0,-0.5,-0.5)*CFrame.Angles(math.rad(-90),0,0)
    weld.Parent=flashPart
    flashLight=Instance.new("SpotLight")
    flashLight.Name="HV3_SpotLight"
    flashLight.Brightness=5
    flashLight.Range=100
    flashLight.Angle=50
    flashLight.Face=Enum.NormalId.Front
    flashLight.Color=Color3.fromRGB(255,240,200)
    flashLight.Shadows=true
    flashLight.Parent=flashPart
end
local function killFlash()
    if flashLight then flashLight:Destroy()flashLight=nil end
    if flashPart then flashPart:Destroy()flashPart=nil end
    if St._flConn then St._flConn:Disconnect()St._flConn=nil end
end

