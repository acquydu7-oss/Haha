    for _,p in pairs(P:GetPlayers())do if p~=L and p.Character then local h=p.Character:FindFirstChildOfClass("Humanoid")if h and h.Health>0 then local pt=p.Character:FindFirstChild("Head")or p.Character:FindFirstChild("HumanoidRootPart")if pt then local sp,on=C:WorldToViewportPoint(pt.Position)if on and sp.Z>0 then local d=math.sqrt((sp.X-cx)^2+(sp.Y-cy)^2)if d<sh then sh=d cl=pt end end end end end end
