local function clrBox()for _,d in pairs(boxObjs)do pcall(function()if d.box then d.box:Destroy()end if d.line then d.line:Destroy()end end)end boxObjs={}end
local function addBox(p)
    if not p or p==L or not p.Character then return end
    local char=p.Character
    if boxObjs[p]then pcall(function()if boxObjs[p].box then boxObjs[p].box:Destroy()end if boxObjs[p].line then boxObjs[p].line:Destroy()end end)boxObjs[p]=nil end
    local d={}
    local ok,box=pcall(function()local b=Instance.new("SelectionBox")b.Adornee=char b.LineThickness=.05 b.Color3=CR b.SurfaceColor3=Color3.fromRGB(0,0,0)b.SurfaceTransparency=1 b.Parent=char return b end)
    if ok then d.box=box end
    local ok2,line=pcall(function()local l=Instance.new("Part")l.Anchored=true l.CanCollide=false l.CanQuery=false l.CanTouch=false l.Material=Enum.Material.Neon l.Color=CR l.Transparency=.2 l.Size=Vector3.new(.15,.15,1)l.Parent=workspace return l end)
    if ok2 then d.line=line end
    boxObjs[p]=d
end
local function upBox()
    if not St.BoxESP then return end
    for _,p in pairs(P:GetPlayers())do
        if p~=L and p.Character then
            local d=boxObjs[p]
            if not d or not d.box or not d.box.Parent or d.box.Adornee~=p.Character then addBox(p)end
            local dd=boxObjs[p]
            if dd and dd.line and dd.line.Parent then
                local hrp=p.Character:FindFirstChild("HumanoidRootPart")
                local mHRP=L.Character and L.Character:FindFirstChild("HumanoidRootPart")
                if hrp and mHRP then
                    local from=mHRP.Position
                    local to=hrp.Position
                    local mid=(from+to)/2
                    local dist=(to-from).Magnitude
                    dd.line.Size=Vector3.new(.15,.15,dist)
                    dd.line.CFrame=CFrame.lookAt(mid,to)
                end
            end
        end
    end
    for pl,d in pairs(boxObjs)do if not pl.Parent or not pl.Character then pcall(function()if d.box then d.box:Destroy()end if d.line then d.line:Destroy()end end)boxObjs[pl]=nil end end
end
