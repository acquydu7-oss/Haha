-- ===== TẠO BẢNG =====
local currentBoard, textLabel

local function createBoard()
    if currentBoard and currentBoard.Parent then
        currentBoard:Destroy()
    end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local board = Instance.new("Part")
    board.Name = "MyWhiteBoard"
    board.Size = Vector3.new(10, 6, 0.3)
    board.Color = Color3.fromRGB(255, 255, 255)
    board.Material = Enum.Material.SmoothPlastic
    board.Anchored = true
    board.CanCollide = false
    board.CFrame = hrp.CFrame * CFrame.new(0, 3, -6)
    board.Parent = Workspace

    local sg = Instance.new("SurfaceGui")
    sg.Face = Enum.NormalId.Front
    sg.CanvasSize = Vector2.new(1000, 600)
    sg.Parent = board

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -40, 1, -40)
    lbl.Position = UDim2.new(0, 20, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text = ""
    lbl.TextColor3 = Color3.new(0, 0, 0)
    lbl.TextScaled = true
    lbl.Font = Enum.Font.GothamBold
    lbl.TextWrapped = true
    lbl.Parent = sg

    currentBoard = board
    textLabel = lbl
end

getBtn.MouseButton1Click:Connect(function()
    createBoard()
    getBtn.Text = "✅  ĐÃ LẤY BẢNG"
    task.wait(1)
    getBtn.Text = "1️⃣  LẤY LẠI BẢNG"
end)

writeBtn.MouseButton1Click:Connect(function()
    if not currentBoard or not currentBoard.Parent then
        createBoard()
    end
    if textLabel then
        textLabel.Text = textBox.Text
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    if currentBoard then currentBoard:Destroy() end
    gui:Destroy()
end)

